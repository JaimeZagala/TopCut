@inject NavigationManager Navigation

@* Sin sesion en una pagina protegida: a la pantalla de acceso, recordando adonde queria ir. *@

@code {
    protected override void OnInitialized()
    {
        var target = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

        Navigation.NavigateTo($"/cuenta/acceso?volver={Uri.EscapeDataString(target)}", forceLoad: false);
    }
}

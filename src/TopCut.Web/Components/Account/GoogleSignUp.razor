@page "/cuenta/google/alta"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@inject IExternalSignInService External
@inject NavigationManager Navigation

@* Google ha verificado quien es, pero no puede aceptar el aviso de protección de datos en su
   nombre, así que la cuenta no se crea hasta que se envia este formulario. *@

<PageTitle>@Textos.GoogleSignUpTitle - @Textos.AppName</PageTitle>

<MudPaper Class="pa-8 mx-auto" MaxWidth="460px" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h1" GutterBottom="true">@Textos.GoogleSignUpTitle</MudText>
    <MudText Typo="Typo.body1" Class="mb-6">@Textos.GoogleSignUpIntro</MudText>

    @if (error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">
            <MudText Typo="Typo.body2">@error</MudText>
        </MudAlert>
    }

    <EditForm Model="Input!" FormName="alta-google" OnValidSubmit="CompleteAsync" method="post">
        <DataAnnotationsValidator />

        <SsrTextField Name="Input.DisplayName"
                      Label="@Textos.FieldDisplayName"
                      Value="@Input!.DisplayName"
                      For="() => Input!.DisplayName"
                      Autocomplete="nickname" />

        <div class="mt-4">
            <SsrCheckBox @bind-Value="Input!.ConsentAccepted" For="() => Input!.ConsentAccepted">
                @Textos.SignUpConsent
            </SsrCheckBox>
            <MudText Typo="Typo.caption">
                @Textos.SignUpConsentDetail
                <MudLink Href="/privacidad" Target="_blank" Typo="Typo.caption">@Textos.PrivacyLink</MudLink>
            </MudText>
        </div>

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mt-6">
            @Textos.SignUpSubmit
        </MudButton>
    </EditForm>
</MudPaper>

@code {
    private string? error;

    [SupplyParameterFromForm]
    private GoogleSignUpModel? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task CompleteAsync()
    {
        error = null;

        var result = await External.CompleteRegistrationAsync(Input!.DisplayName, Input!.ConsentAccepted);

        if (!result.Succeeded)
        {
            error = string.Join(" ", result.Errors);
            return;
        }

        Navigation.NavigateTo("/", forceLoad: true);
    }

    private sealed class GoogleSignUpModel
    {
        [Required(ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationDisplayNameRequired))]
        [StringLength(200, MinimumLength = 2, ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationDisplayNameLength))]
        public string DisplayName { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationConsentRequired))]
        public bool ConsentAccepted { get; set; }
    }
}

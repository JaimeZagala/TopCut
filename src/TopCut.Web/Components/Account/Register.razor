@page "/cuenta/registro"
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@inject IAccountService Accounts
@inject ISignInService SignIn
@inject NavigationManager Navigation

@* SSR estático a propósito: el alta es un envio de formulario normal, y entrar justo después
   necesita el HttpContext que solo existe en una petición de verdad. Los campos no usan
   @@bind-Value porque en SSR estático no hay eventos: el valor llega en el POST y el enlace de
   formulario del servidor lo escribe en el modelo. *@

<PageTitle>@Textos.SignUpTitle - @Textos.AppName</PageTitle>

<MudPaper Class="pa-8 mx-auto" MaxWidth="460px" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h1" GutterBottom="true">@Textos.SignUpTitle</MudText>

    @if (errors.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">
            <MudText Typo="Typo.body2">@string.Join(" ", errors)</MudText>
        </MudAlert>
    }

    <EditForm Model="Input!" FormName="registro" OnValidSubmit="RegisterAsync" method="post">
        <DataAnnotationsValidator />

        <SsrTextField Name="Input.DisplayName"
                      Label="@Textos.FieldDisplayName"
                      Value="@Input!.DisplayName"
                      For="() => Input!.DisplayName"
                      Autocomplete="nickname" />

        <SsrTextField Name="Input.Email"
                      Label="@Textos.FieldEmail"
                      Value="@Input!.Email"
                      For="() => Input!.Email"
                      InputType="InputType.Email"
                      Autocomplete="username"
                      Class="mt-4" />

        <SsrTextField Name="Input.Password"
                      Label="@Textos.FieldPassword"
                      Value="@Input!.Password"
                      For="() => Input!.Password"
                      InputType="InputType.Password"
                      Autocomplete="new-password"
                      Class="mt-4" />

        <div class="mt-4">
            <SsrCheckBox @bind-Value="Input!.ConsentAccepted" For="() => Input!.ConsentAccepted">
                @Textos.SignUpConsent
            </SsrCheckBox>
            <MudText Typo="Typo.caption">
                @Textos.SignUpConsentDetail
                <MudLink Href="/privacidad" Target="_blank" Typo="Typo.caption">@Textos.PrivacyLink</MudLink>
            </MudText>
        </div>

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mt-6">
            @Textos.SignUpSubmit
        </MudButton>
    </EditForm>

    <MudText Typo="Typo.body2" Class="mt-6">
        @Textos.SignUpHaveAccount <MudLink Href="/cuenta/acceso">@Textos.NavSignIn</MudLink>
    </MudText>
</MudPaper>

@code {
    private readonly List<string> errors = [];

    [SupplyParameterFromForm]
    private RegisterModel? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task RegisterAsync()
    {
        errors.Clear();

        var result = await Accounts.RegisterPlayerAsync(
            new RegistrationRequest(Input!.Email, Input!.Password, Input!.DisplayName, Input!.ConsentAccepted));

        if (!result.Succeeded)
        {
            errors.AddRange(result.Errors);
            return;
        }

        // Straight in: making someone log in again right after registering is pointless friction.
        await SignIn.SignInWithCookieAsync(Input!.Email, Input!.Password, rememberMe: false);
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationDisplayNameRequired))]
        [StringLength(200, MinimumLength = 2, ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationDisplayNameLength))]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationEmailRequired))]
        [EmailAddress(ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationEmailInvalid))]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationPasswordRequired))]
        [StringLength(100, MinimumLength = 8, ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationPasswordLength))]
        public string Password { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessageResourceType = typeof(Textos), ErrorMessageResourceName = nameof(Textos.ValidationConsentRequired))]
        public bool ConsentAccepted { get; set; }
    }
}

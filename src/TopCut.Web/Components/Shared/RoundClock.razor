@implements IAsyncDisposable
@inject IJSRuntime JS

@* El reloj de la ronda. El servidor solo dice cuando termina; la cuenta atrás la lleva el
   navegador (ADR-0028), así que no cuesta un mensaje por segundo y por espectador.

   El texto se pinta ya desde el servidor para que se vea algo en el primer render, antes de que
   el JavaScript tome el relevo. *@

<span @ref="host"
      class="topcut-clock"
      data-state="@InitialState"
      data-ends-at="@EndsAt.ToUnixTimeMilliseconds()"
      data-extra-ends-at="@ExtraEndsAt.ToUnixTimeMilliseconds()"
      data-server-now="@ServerNow.ToUnixTimeMilliseconds()"
      data-extra-label="@Textos.ClockExtraTime"
      data-over-label="@Textos.ClockOver">@InitialText</span>

@if (SelfStart)
{
    @* En SSR estático no hay circuito, así que nadie va a llamar al módulo por interoperabilidad:
       lo arranca esta etiqueta leyendo los mismos datos del propio elemento. El JavaScript es el de
       siempre; lo único que cambia es quién lo pone en marcha. *@
    <script type="module" suppress-error="BL9992">
        import { start } from './js/roundClock.js';

        for (const clock of document.querySelectorAll('.topcut-clock[data-ends-at]')) {
            start(clock, {
                endsAtMs: Number(clock.dataset.endsAt),
                extraEndsAtMs: Number(clock.dataset.extraEndsAt),
                serverNowMs: Number(clock.dataset.serverNow),
                extraLabel: clock.dataset.extraLabel,
                overLabel: clock.dataset.overLabel
            });
        }
    </script>
}

@code {
    private ElementReference host;
    private IJSObjectReference? module;
    private bool ticking;

    /// <summary>End of normal play, in UTC.</summary>
    [Parameter, EditorRequired]
    public DateTimeOffset EndsAt { get; set; }

    /// <summary>End of overtime. Equal to <see cref="EndsAt"/> when the game has none.</summary>
    [Parameter, EditorRequired]
    public DateTimeOffset ExtraEndsAt { get; set; }

    /// <summary>
    /// The server's clock at the moment this was read, so the browser can correct for its own being
    /// off without the two ever having to agree on what time it is.
    /// </summary>
    [Parameter, EditorRequired]
    public DateTimeOffset ServerNow { get; set; }

    /// <summary>
    /// Start the countdown from a script tag instead of waiting for a circuit. For the pages served
    /// as static SSR — the player's own screen — where <c>OnAfterRenderAsync</c> never gets an
    /// interactive renderer to talk to.
    /// </summary>
    [Parameter]
    public bool SelfStart { get; set; }

    private string InitialText => Remaining switch
    {
        { TotalSeconds: > 0 } left => Labels.Countdown(left),
        _ when ExtraEndsAt > ServerNow => $"{Textos.ClockExtraTime} {Labels.Countdown(ExtraEndsAt - ServerNow)}",
        _ => Textos.ClockOver
    };

    private string InitialState => Remaining switch
    {
        { TotalSeconds: > 0 } => "running",
        _ when ExtraEndsAt > ServerNow => "extra",
        _ => "over"
    };

    private TimeSpan Remaining => EndsAt - ServerNow;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Nothing to run against during prerendering: the server-rendered text stands until the
        // circuit is up.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/roundClock.js");

        // Restarted on every render on purpose: a new round means new instants, and start() clears
        // whatever was ticking before.
        await module.InvokeVoidAsync("start", host, new
        {
            endsAtMs = EndsAt.ToUnixTimeMilliseconds(),
            extraEndsAtMs = ExtraEndsAt.ToUnixTimeMilliseconds(),
            serverNowMs = ServerNow.ToUnixTimeMilliseconds(),
            extraLabel = Textos.ClockExtraTime,
            overLabel = Textos.ClockOver
        });

        ticking = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            if (ticking)
            {
                await module.InvokeVoidAsync("stop", host);
            }

            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away before we could tidy up, which takes the timer with it.
        }
    }
}

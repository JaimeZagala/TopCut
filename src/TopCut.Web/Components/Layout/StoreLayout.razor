@inherits LayoutComponentBase
@inject ITenantScope TenantScope

@* Cascara de gestion. Solo la usan paginas interactivas, asi que aqui si hay cajon lateral que se
   abre y se cierra, dialogos y avisos emergentes.

   Ademas fija la tienda en contexto (ADR-0024): dentro de un circuito de SignalR no hay
   HttpContext del que sacarla, y sin ella el filtro de tenant —que falla cerrado— dejaria a la
   tienda sin ver sus propios datos. Se lee del claim del usuario ya autenticado, que es
   exactamente lo mismo que lee el camino HTTP, y ocurre en el layout porque este se renderiza
   entero antes que la pagina que lleva dentro. *@

<MudThemeProvider Theme="TopCutTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="@Textos.NavMenuToggle"
                       OnClick="@(() => drawerOpen = !drawerOpen)" />
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6">
            @Textos.AppName
        </MudLink>
        <MudSpacer />
        <AccountBar />
    </MudAppBar>

    @* Mini: contraer no esconde la navegacion, la reduce a los iconos, que en una mesa de control
       es lo que se quiere — mas sitio para la tabla sin perder de vista donde esta uno. Por debajo
       de su breakpoint MudBlazor lo trata como temporal, asi que en un movil si desaparece. *@
    <MudDrawer @bind-Open="drawerOpen"
               Elevation="1"
               ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Mini"
               MiniWidth="56px"
               OpenMiniOnHover="true">
        <StoreNav />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @Textos.ErrorTitle
    <a href="." class="reload">@Textos.BackHome</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;

    [CascadingParameter]
    private Task<AuthenticationState>? Authentication { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Authentication is null)
        {
            return;
        }

        var claim = (await Authentication).User.FindFirst(TopCutClaims.Tenant)?.Value;

        TenantScope.Set(Guid.TryParse(claim, out var storeId) ? storeId : null);
    }
}

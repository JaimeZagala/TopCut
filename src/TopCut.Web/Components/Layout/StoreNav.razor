@* Navegacion del organizador. Con el cajón contraido solo se ven los iconos, así que cada entrada
   lleva el suyo y no depende del texto. *@

<MudNavMenu Class="pa-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        @Textos.NavHome
    </MudNavLink>
    <MudNavLink Href="/tienda" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        @Textos.StoreDashboardTitle
    </MudNavLink>
    <MudNavLink Href="/tienda/torneos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EmojiEvents">
        @Textos.NavTournaments
    </MudNavLink>
    <MudNavLink Href="/tienda/ligas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MilitaryTech">
        @Textos.NavLeagues
    </MudNavLink>
    <MudNavLink Href="/tienda/jugadores" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups">
        @Textos.NavBook
    </MudNavLink>
</MudNavMenu>

@inherits LayoutComponentBase
@inject ITenantScope TenantScope

@* Cáscara de la pantalla en vivo: la que se proyecta en la sala. Sin barra ni cajón lateral, porque
   nadie va a navegar desde ahí y cada pixel gastado en cromo es un pixel menos de nombres legibles
   desde el fondo. Fija la tienda en contexto igual que StoreLayout (ADR-0024). *@

<MudThemeProvider Theme="TopCutTheme.Default" />
<MudPopoverProvider />

<div class="topcut-live">
    @Body
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? Authentication { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Authentication is null)
        {
            return;
        }

        var claim = (await Authentication).User.FindFirst(TopCutClaims.Tenant)?.Value;

        TenantScope.Set(Guid.TryParse(claim, out var storeId) ? storeId : null);
    }
}

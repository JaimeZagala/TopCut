@page "/"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>@Textos.AppName</PageTitle>

<MudText Typo="Typo.h1" GutterBottom="true">@Textos.HomeTitle</MudText>
<MudText Typo="Typo.body1" Class="mb-8">@Textos.HomeIntro</MudText>

<MudGrid Spacing="4">
    <MudItem xs="12" md="4">
        <Feature Icon="@Icons.Material.Filled.SportsEsports"
                 Title="@Textos.HomePlayersTitle"
                 Body="@Textos.HomePlayersBody" />
    </MudItem>
    <MudItem xs="12" md="4">
        <Feature Icon="@Icons.Material.Filled.Storefront"
                 Title="@Textos.HomeStoresTitle"
                 Body="@Textos.HomeStoresBody" />
    </MudItem>
    <MudItem xs="12" md="4">
        <Feature Icon="@Icons.Material.Filled.Gavel"
                 Title="@Textos.HomeRulesTitle"
                 Body="@Textos.HomeRulesBody" />
    </MudItem>
</MudGrid>

<AuthorizeView>
    <NotAuthorized>
        <MudStack Row="true" Spacing="3" Class="mt-8">
            <MudButton Href="/cuenta/registro" Variant="Variant.Filled" Color="Color.Primary">
                @Textos.NavSignUp
            </MudButton>
            <MudButton Href="/cuenta/acceso" Variant="Variant.Text" Color="Color.Primary">
                @Textos.NavSignIn
            </MudButton>
        </MudStack>
    </NotAuthorized>
</AuthorizeView>

@* Las pestañas de un torneo. Son enlaces de verdad, no un control de pestañas: cada una es una
   página con su propia dirección, así que se puede recargar y compartir.

   La pestaña en la que ya estás **no lleva enlace**. Navegar a la dirección en la que ya estás
   vuelve a cargar la pantalla desde la base de datos, así que pulsar "Datos" estando en Datos
   descartaba en silencio lo que hubieras cambiado sin guardar. *@

<MudStack Row="true" Spacing="2" Class="mb-6" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
    @foreach (var tab in Tabs)
    {
        <MudButton Href="@(tab.Key == Current ? null : $"/tienda/torneos/{TournamentId}{tab.Suffix}")"
                   StartIcon="@tab.Icon"
                   Variant="@(tab.Key == Current ? Variant.Filled : Variant.Text)"
                   Color="Color.Primary"
                   aria-current="@(tab.Key == Current ? "page" : null)">
            @tab.Label
        </MudButton>
    }

    @* Abre en otra pestaña, así que no es una de estas: se distingue con el contorno en gris, sin
       competir por color con la pestaña activa ni con las acciones. *@
    <MudButton Href="@($"/tienda/torneos/{TournamentId}/en-vivo")"
               Target="_blank"
               StartIcon="@Icons.Material.Filled.Cast"
               Variant="Variant.Outlined"
               Color="Color.Default"
               title="@Textos.LiveOpenHint">
        @Textos.LiveOpen
    </MudButton>

    <MudSpacer />

    @* Anclada al otro extremo, lo más lejos posible de la navegacion: es la única accion de aquí
       que no tiene vuelta atrás. Pide confirmación igualmente. *@
    @if (CanCancel)
    {
        <MudButton StartIcon="@Icons.Material.Filled.Cancel"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   Disabled="Busy"
                   OnClick="OnCancel">
            @Textos.ActionCancelTournament
        </MudButton>
    }
</MudStack>

@code {
    private static (TournamentTab Key, string Suffix, string Icon, string Label)[] Tabs =>
    [
        (TournamentTab.Details, "", Icons.Material.Filled.Tune, Textos.TabDetails),
        (TournamentTab.Participants, "/participantes", Icons.Material.Filled.Groups, Textos.TabParticipants),
        (TournamentTab.Desk, "/mesa", Icons.Material.Filled.PlayCircle, Textos.TabDesk)
    ];

    [Parameter, EditorRequired]
    public Guid TournamentId { get; set; }

    [Parameter, EditorRequired]
    public TournamentTab Current { get; set; }

    /// <summary>A finished or already cancelled tournament has nothing left to cancel.</summary>
    [Parameter]
    public bool CanCancel { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}

@page "/tienda"
@layout StoreLayout
@attribute [Authorize(Policy = TopCutPolicies.CanOrganize)]

@* Primera página de la zona de gestión. La política no mira solo el rol: comprueba contra la base
   de datos que la tienda sigue aprobada, así que revocarla cierra esta pantalla en la petición
   siguiente y no cuando caduque la cookie. *@

<PageTitle>@Textos.StoreDashboardTitle - @Textos.AppName</PageTitle>

<MudText Typo="Typo.h1" GutterBottom="true">@Textos.StoreDashboardTitle</MudText>
<MudText Typo="Typo.body1" Class="mb-6">@Textos.StoreDashboardIntro</MudText>

<MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
    <MudButton Href="/tienda/torneos"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.EmojiEvents">
        @Textos.NavTournaments
    </MudButton>
    <MudButton Href="/tienda/torneos/nuevo"
               Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">
        @Textos.TournamentsNew
    </MudButton>
</MudStack>

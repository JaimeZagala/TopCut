@page "/tienda/jugadores"
@layout StoreLayout
@attribute [Authorize(Policy = TopCutPolicies.CanOrganize)]
@inject IStorePlayers Book
@inject LocalTime Clock
@inject ISnackbar Snackbar

@* El fichero de jugadores de la tienda (ADR-0035): quien ha jugado aquí, que es lo que permite
   sumar los puntos de una misma persona a lo largo de una liga.

   No se rellena a mano. Se va llenando solo cada vez que la tienda apunta a alguien en el
   mostrador o alguien se inscribe desde la web; aquí solo se corrige. *@

<PageTitle>@Textos.BookTitle - @Textos.AppName</PageTitle>

<MudText Typo="Typo.h1" GutterBottom="true">@Textos.BookTitle</MudText>
<MudText Typo="Typo.body1" Class="mb-6">@Textos.BookIntro</MudText>

@if (rows is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Textos.Loading" />
}
else if (rows.Count == 0)
{
    <MudPaper Class="pa-8 text-center" Elevation="0" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
        <MudText Typo="Typo.body1">@Textos.BookEmpty</MudText>
    </MudPaper>
}
else
{
    <MudTable Items="rows" Hover="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>@Textos.BookColumnPlayer</MudTh>
            <MudTh>@Textos.BookColumnTournaments</MudTh>
            <MudTh>@Textos.BookColumnLastPlayed</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate Context="row">
            <MudTd DataLabel="@Textos.BookColumnPlayer">
                <MudText Typo="Typo.body1">@row.Name</MudText>
                <MudStack Row="true" Spacing="1" Class="mt-1">
                    @if (row.HasAccount)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                 title="@Textos.BookHasAccountHint">
                            @Textos.BookHasAccount
                        </MudChip>
                    }
                    @if (row.PossibleDuplicateOf is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                 title="@Textos.BookPossibleDuplicateHint">
                            @Textos.BookPossibleDuplicate
                        </MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="@Textos.BookColumnTournaments">@row.Tournaments</MudTd>
            <MudTd DataLabel="@Textos.BookColumnLastPlayed">
                @(row.LastPlayedAt is { } played ? Clock.Format(played) : Textos.BookNeverPlayed)
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                    @if (row.PossibleDuplicateOf is { } twin)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Merge"
                                       Size="Size.Small"
                                       Color="Color.Warning"
                                       title="@Textos.BookMerge"
                                       Disabled="busy"
                                       OnClick="@(() => StartMerge(row, twin))" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   title="@Textos.BookRename"
                                   Disabled="busy"
                                   OnClick="@(() => StartRename(row))" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* Los dos diálogos se quedan siempre montados y se abren con Visible, como el de la pantalla de
   participantes. Envolverlos en un @@if los abre igual de bien, pero quitarlos del árbol no los
   cierra: el contenedor de MudBlazor se queda con ellos y con su velo por encima. *@
<MudDialog @bind-Visible="renaming" Options="Dialog">
    <TitleContent>@Textos.BookRenameTitle</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">@Textos.BookRenameHint</MudText>
        <MudTextField @bind-Value="renameTo"
                      Label="@Textos.BookColumnPlayer"
                      Variant="Variant.Outlined"
                      Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => renaming = false)">@Textos.ActionCancel</MudButton>
        <MudButton Color="Color.Primary"
                   Disabled="@(busy || string.IsNullOrWhiteSpace(renameTo))"
                   OnClick="RenameAsync">
            @Textos.ActionSave
        </MudButton>
    </DialogActions>
</MudDialog>

@* Fusionar es lo único de esta pantalla que no tiene vuelta atrás, así que el diálogo dice qué se
   queda, qué desaparece y cuántos torneos se mueven, y obliga a elegir cuál de las dos fichas
   sobrevive en vez de decidirlo por su cuenta. *@
<MudDialog @bind-Visible="merging" Options="Dialog">
    <TitleContent>@Textos.BookMergeTitle</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">@Textos.BookMergeHint</MudText>

        <MudRadioGroup T="Guid" @bind-Value="keepId">
            @foreach (var option in pair)
            {
                <MudRadio T="Guid" Value="option.Id" Class="d-block mb-2">
                    <MudText Typo="Typo.body1">@option.Name</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @Played(option.Tournaments)@(option.HasAccount ? $" · {Textos.BookHasAccount}" : string.Empty)
                    </MudText>
                </MudRadio>
            }
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => merging = false)">@Textos.ActionCancel</MudButton>
        <MudButton Color="Color.Warning"
                   Variant="Variant.Filled"
                   Disabled="busy"
                   OnClick="MergeAsync">
            @Textos.BookMergeConfirm
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<StorePlayerRow>? rows;

    private bool busy;
    private bool renaming;
    private Guid renameId;
    private string renameTo = string.Empty;

    private static readonly DialogOptions Dialog = new() { CloseOnEscapeKey = true };

    private bool merging;
    private StorePlayerRow[] pair = [];
    private Guid keepId;

    /// <summary>"1 torneo", no "1 torneos".</summary>
    private static string Played(int tournaments) => tournaments switch
    {
        0 => Textos.BookTournamentsNone,
        1 => Textos.BookTournamentsOne,
        var many => string.Format(Textos.BookTournaments, many)
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => rows = await Book.AllAsync();

    private void StartMerge(StorePlayerRow row, Guid twinId)
    {
        if (rows?.FirstOrDefault(candidate => candidate.Id == twinId) is not { } twin)
        {
            return;
        }

        pair = [row, twin];

        // Preseleccionada la que más ha jugado, que es casi siempre la que la tienda quiere
        // conservar; pero se puede cambiar, porque "casi siempre" no es siempre.
        keepId = row.Tournaments >= twin.Tournaments ? row.Id : twin.Id;
        merging = true;
    }

    private async Task MergeAsync()
    {
        if (pair.Length != 2)
        {
            return;
        }

        busy = true;

        try
        {
            var fold = pair.Single(candidate => candidate.Id != keepId).Id;
            var result = await Book.MergeAsync(keepId, fold);

            if (!result.Succeeded)
            {
                Snackbar.Add(string.Join(" ", result.Errors), Severity.Error);
                return;
            }

            merging = false;
            Snackbar.Add(Textos.BookMerged, Severity.Success);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private void StartRename(StorePlayerRow row)
    {
        renameId = row.Id;
        renameTo = row.Name;
        renaming = true;
    }

    private async Task RenameAsync()
    {
        busy = true;

        try
        {
            var result = await Book.RenameAsync(renameId, renameTo);

            if (!result.Succeeded)
            {
                Snackbar.Add(string.Join(" ", result.Errors), Severity.Error);
                return;
            }

            renaming = false;
            Snackbar.Add(Textos.BookRenamed, Severity.Success);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}

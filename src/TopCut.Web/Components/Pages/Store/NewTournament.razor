@page "/tienda/torneos/nuevo"
@layout StoreLayout
@attribute [Authorize(Policy = TopCutPolicies.CanOrganize)]
@using TopCut.Application.Tournaments
@inject ITcgCatalog Catalog
@inject TournamentSetupService Setup
@inject LocalTime Clock
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@Textos.TournamentNewTitle - @Textos.AppName</PageTitle>

<MudText Typo="Typo.h1" GutterBottom="true">@Textos.TournamentNewTitle</MudText>

@if (games is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Textos.Loading" />
}
else if (games.Count == 0)
{
    <MudAlert Severity="Severity.Warning">@Textos.ValidationGameRequired</MudAlert>
}
else
{
    @if (errors.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@string.Join(" ", errors)</MudAlert>
    }

    <TournamentForm Model="model!"
                    Games="games"
                    SubmitLabel="@Textos.TournamentsNew"
                    Busy="busy"
                    OnSubmit="CreateAsync" />
}

@code {
    private readonly List<string> errors = [];

    private IReadOnlyList<TcgOption>? games;
    private TournamentFormModel? model;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        games = await Catalog.ActiveAsync();

        // The form opens already filled in with the first game's own rules and the number of rounds
        // its rulebook prescribes, so the common case is "check it and save" (ADR-0018).
        if (games.Count > 0)
        {
            model = TournamentFormModel.For(games[0], Clock.ToLocal(DateTimeOffset.UtcNow));
        }
    }

    private async Task CreateAsync()
    {
        errors.Clear();
        busy = true;

        try
        {
            var result = await Setup.CreateAsync(model!.ToDraft(Clock), model.ToRules());

            if (!result.Succeeded)
            {
                errors.AddRange(result.Errors);
                return;
            }

            Snackbar.Add(Textos.NoticeCreated, Severity.Success);
            Navigation.NavigateTo($"/tienda/torneos/{result.TournamentId}");
        }
        finally
        {
            busy = false;
        }
    }
}

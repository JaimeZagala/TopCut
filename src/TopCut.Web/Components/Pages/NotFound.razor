@page "/not-found"
@attribute [ExcludeFromInteractiveRouting]
@layout MainLayout

<PageTitle>@Textos.NotFoundTitle - @Textos.AppName</PageTitle>

<MudText Typo="Typo.h1" GutterBottom="true">@Textos.NotFoundTitle</MudText>
<MudText Typo="Typo.body1" Class="mb-6">@Textos.NotFoundBody</MudText>

<MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">@Textos.BackHome</MudButton>

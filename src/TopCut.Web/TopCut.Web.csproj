<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TopCut.Application\TopCut.Application.csproj" />
    <ProjectReference Include="..\TopCut.Infrastructure\TopCut.Infrastructure.csproj" />
    <ProjectReference Include="..\TopCut.Api\TopCut.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <!-- MSBuild genera la clase fuertemente tipada a partir del .resx en cada compilacion
       (ADR-0019). No hay archivo .Designer.cs en el repositorio que se pueda desincronizar,
       y una clave mal escrita es un error de compilacion, no una cadena rara en pantalla. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Textos.resx">
      <Generator></Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Textos.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>TopCut.Web.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Textos</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>791708c5-10e7-4ce2-a612-1b26a849ce08</UserSecretsId>
  </PropertyGroup>

</Project>

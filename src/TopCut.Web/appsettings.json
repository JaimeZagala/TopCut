{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TopCut": {
    // Zona en la que se interpretan las fechas y horas que teclea la tienda (ADR-0025). No se
    // puede usar la de la maquina: en produccion el servidor corre en UTC.
    "TimeZone": "Europe/Madrid"
  }
}
